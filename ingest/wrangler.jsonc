{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "ecosystem-ci-ingest",
	"account_id": "f92591bbb8e5dcf6602b801e68bbd56c",
	"main": "src/index.ts",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "biome-ecosystem-ci",
			"database_id": "fc4adc5f-7573-45d5-bc48-4c9fc704cc57",
			"migrations_dir": "../dashboard/migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "REPORTS",
			"bucket_name": "biome-ecosystem-ci-reports"
		}
	],
	"queues": {
		"consumers": [
			{
				"queue": "ecosystem-ci-ingest",
				"max_batch_size": 1,
				"max_batch_timeout": 5
			}
		]
	}
}
