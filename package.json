{
	"name": "biome-ecosystem-ci",
	"private": true,
	"packageManager": "pnpm@11.25.0",
	"type": "module",
	"scripts": {
		"lint": "biome check",
		"test": "pnpm --dir dashboard exec svelte-kit sync && vitest run",
		"test:browser": "pnpm --dir dashboard run test:browser",
		"dev": "pnpm --dir dashboard run dev",
		"build": "pnpm --dir dashboard run build && pnpm --dir ingest run build",
		"check": "pnpm --dir dashboard run check",
		"reports:download": "pnpm --dir dashboard run reports:download",
		"reports:import": "pnpm --dir dashboard run reports:import",
		"reports:diagnostics": "pnpm --dir dashboard run reports:diagnostics",
		"deploy": "pnpm --dir dashboard run deploy && pnpm --dir ingest run deploy"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"tsx": "^4.20.5",
		"vitest": "^4.1.11"
	}
}
