{
	"name": "@biomejs/ecosystem-ci-dashboard",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"deploy": "pnpm run build && wrangler deploy",
		"cf-typegen": "wrangler types cloudflare-env.d.ts",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote",
		"db:seed:local": "tsx scripts/seed-local.ts",
		"db:setup:local": "pnpm run db:migrate:local && pnpm run db:seed:local",
		"reports:download": "tsx scripts/download-r2.ts",
		"reports:import": "tsx scripts/import-ci-runs.ts",
		"reports:diagnostics": "tsx scripts/read-diagnostics.ts"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^5.20260819.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.19.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.2.2",
		"wrangler": "^4.124.0"
	},
	"dependencies": {
		"@biomejs/ecosystem-ci-ingest": "workspace:*",
		"zod": "^4.4.3"
	}
}
